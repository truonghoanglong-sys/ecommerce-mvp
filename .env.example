# ===== Bí mật dùng chung =====
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=3600

# ===== PostgreSQL (mỗi service 1 DB riêng) =====
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth_pw
AUTH_DB_NAME=auth_db

CUSTOMER_DB_USER=customer
CUSTOMER_DB_PASSWORD=customer_pw
CUSTOMER_DB_NAME=customer_db

ORDER_DB_USER=order
ORDER_DB_PASSWORD=order_pw
ORDER_DB_NAME=order_db
