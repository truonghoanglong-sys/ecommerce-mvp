PORT=8080
# PHẢI giống JWT_SECRET của auth-service, nếu không mọi token đều bị từ chối
JWT_SECRET=change_me_to_a_long_random_string
REDIS_URL=redis://localhost:6379
PROTO_DIR=../../shared/proto

# gRPC: Gateway gọi các service (đúng sơ đồ kiến trúc)
AUTH_GRPC_URL=localhost:50051
CUSTOMER_GRPC_URL=localhost:50052
PRODUCT_GRPC_URL=localhost:50053
ORDER_GRPC_URL=localhost:50054
SHIPMENT_GRPC_URL=localhost:50055

# HTTP /health của từng service (cho GET /api/health)
AUTH_HEALTH_URL=http://localhost:3001
CUSTOMER_HEALTH_URL=http://localhost:3002
PRODUCT_HEALTH_URL=http://localhost:3003
ORDER_HEALTH_URL=http://localhost:3004
SHIPMENT_HEALTH_URL=http://localhost:3005

# Rate limit: số request tối đa trong 1 cửa sổ thời gian
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100
# Riêng /api/auth (đăng nhập/đăng ký) chặt hơn để chống dò mật khẩu
AUTH_RATE_LIMIT_MAX=20

# Cache danh sách / chi tiết sản phẩm (giây)
PRODUCT_CACHE_TTL_SECONDS=30
