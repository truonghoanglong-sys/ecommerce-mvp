PORT=3001
# gRPC: API Gateway gọi Register / Login qua cổng này
GRPC_PORT=50051
DATABASE_URL=postgres://auth:auth_pw@localhost:5433/auth_db
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=3600
BCRYPT_ROUNDS=10
# Customer Service (gRPC) – để tạo hồ sơ khách hàng khi đăng ký (ADR-06)
CUSTOMER_GRPC_URL=localhost:50052
PROTO_DIR=../../shared/proto
# Tài khoản seed sẵn để test các API cần quyền Admin / Shipment Staff
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_STAFF_USERNAME=shipper
SEED_STAFF_PASSWORD=Shipper@123
